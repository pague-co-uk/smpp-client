APP_NAME=sms-gateway-smpp-client
APP_VERSION=1.0.0
NODE_ENV=development

DATABASE_URL=mysql://sms_gateway:password@localhost:3306/sms_gateway

# ============================================================================
# RabbitMQ
# ============================================================================

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_CONNECTION_NAME=sms-gateway-smpp-client

RABBITMQ_HEARTBEAT=60
RABBITMQ_RECONNECT_DELAY=1000
RABBITMQ_MAX_RECONNECT_DELAY=30000
RABBITMQ_AUTO_CREATE_QUEUES=true
RABBITMQ_AUTO_RECOVER=true
RABBITMQ_CONSUMER_PREFETCH=10

# ============================================================================
# Routing
# ============================================================================

ROUTING_CONSUMER_QUEUE=sms.route.smpp
ROUTING_RESULT_QUEUE=sms.route.result

# ============================================================================
# OpenTelemetry
# ============================================================================

OTEL_ENABLED=false

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=debug
LOG_STDOUT=true
LOG_FILE_ENABLED=false
# =============================================================================
# Application
# =============================================================================

APP_NAME=sms-gateway-smpp-client
APP_VERSION=1.0.0
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=9004

DATABASE_URL=mysql://sms_gateway:password@localhost:3306/sms_gateway


# =============================================================================
# RabbitMQ
# =============================================================================

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_CONNECTION_NAME=sms-gateway-smpp-client
RABBITMQ_HEARTBEAT=60
RABBITMQ_RECONNECT_DELAY=1000
RABBITMQ_MAX_RECONNECT_DELAY=30000
RABBITMQ_MAX_RECONNECT_ATTEMPTS=
RABBITMQ_AUTO_RECOVER=true
RABBITMQ_CONSUMER_PREFETCH=10

# =============================================================================
# OpenTelemetry
# =============================================================================

OTEL_ENABLED=false
OTEL_SERVICE_NAME=sms-gateway-smpp-client
OTEL_SERVICE_VERSION=1.0.0
OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_EXPORT_INTERVAL_MILLIS=10000
OTEL_DISABLE_FS_INSTRUMENTATION=false


# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=debug
LOG_STDOUT=true
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/pague/sms-gateway-smpp-client/application.log

# =============================================================================
# Routing
# =============================================================================

ROUTING_CONSUMER_QUEUE=sms.route.smpp
ROUTING_RESULT_QUEUE=sms.route.result
ROUTING_DELIVERY_RECEIPT_QUEUE=sms.route.delivery-receipt